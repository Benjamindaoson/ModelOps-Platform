# Production installation requires Postgres, OIDC JWT issuer/JWKS, Argo CRDs, namespaces and K8s RBAC.
MODELOPS_ENV=development
MODELOPS_AUTH_MODE=dev
MODELOPS_RUNTIME=disabled
MODELOPS_DATABASE_URL=sqlite:///./modelops.db
# Generate a random 32+ character secret locally; do not commit it.
# MODELOPS_JWT_SECRET=...
# MODELOPS_ATTESTATION_KEY=...
