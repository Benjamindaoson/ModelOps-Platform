# URL is server-side ONLY; never expose the internal control API key to client JS.
MODELOPS_API_URL=http://127.0.0.1:8080
MODELOPS_PUBLIC_ORIGIN=http://localhost:3000
MODELOPS_ENV=development
MODELOPS_CONSOLE_AUTH=development-token
# For production, set:
# MODELOPS_ENV=production
# MODELOPS_CONSOLE_AUTH=oidc
# MODELOPS_OIDC_ISSUER=https://idp.example.com/realms/modelops
# MODELOPS_OIDC_CLIENT_ID=modelops-ui
# MODELOPS_PUBLIC_ORIGIN=https://modelops.example.com
